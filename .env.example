# MongoDB Connection String
# Local MongoDB (via Docker or local service)
MONGODB_URI=mongodb://127.0.0.1:27017/project_tracker

# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/project_tracker?retryWrites=true&w=majority

# Authentication Secret
AUTH_SECRET=your_jwt_secret_key_here
